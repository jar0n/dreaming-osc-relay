  "full_title": "A Man blowing Smoke at a Drunken Woman, Another Man with a Wine-pot",
  "short_title": "A Man blowing Smoke at a Drunken Woman",
  "object_name": "Picture",
  "style": "baroque",
  "material": "oil on wood",
