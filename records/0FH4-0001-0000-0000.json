  "full_title": "Saint Peter Martyr and a Bishop Saint (probably Saint Evasio)",
  "short_title": "Saint Peter Martyr and a Bishop Saint (Saint Evasio?)",
  "object_name": "Picture",
  "style": "early Renaissance",
  "material": "oil on wood",
