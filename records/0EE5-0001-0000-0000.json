  "full_title": "The Interior of the Oude Kerk, Amsterdam, during a Sermon",
  "short_title": "The Interior of the Oude Kerk, Amsterdam",
  "object_name": "Picture",
  "style": "baroque",
  "material": "oil on canvas",
